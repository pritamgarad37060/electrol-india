no":270,"depc":0,"status":"Answered  ","P_flag":"Y","files":"https://sansad.in/getFile/annex/270/AU1145_8uVqwN.pdf?source=pqars","hindifiles":"https://sansad.in/getFile/qhindi/270/AU1145_8uVqwN.pdf?source=pqars","eng_file_name":"AU1145_8uVqwN.pdf","hindi_file_name":"AU1145_8uVqwN.pdf","eng_file_dsp":"/getFile/annex/270/AU1145_8uVqwN.pdf?source=pqars","hindi_file_dsp":"/getFile/qhindi/270/AU1145_8uVqwN.pdf?source=pqars","min_code":0,"supp":null},{"mp_code":2619,"qslno":321265,"qtitle":"Accidents during track maintenance","qtype":"UNSTARRED ","ans_date":"06.02.2026","adate":"2026-02-06T00:00:00","shri":"Smt.      ","qno":905,"name":"Mamata Thakur                           ","min_name":"RAILWAYS","qn_text":"(a) the total number of railway staff injured and died in track maintenance accidents; and\r\n(b) whether there is any compensation mechanism for such losses?","ans_text":null,"ses_no":270,"depc":0,"status":"Answered  ","P_flag":"Y","files":"https://sansad.in/getFile/annex/270/AU905_x6EKKi.pdf?source=pqars","hindifiles":"https://sansad.in/getFile/qhindi/270/AU905_x6EKKi.pdf?source=pqars","eng_file_name":"AU905_x6EKKi.pdf","hindi_file_name":"AU905_x6EKKi.pdf","eng_file_dsp":"/getFile/annex/270/AU905_x6EKKi.pdf?source=pqars","hindi_file_dsp":"/getFile/qhindi/270/AU905_x6EKKi.pdf?source=pqars","min_code":0,"supp":null},{"mp_code":2619,"qslno":320288,"qtitle":"Vacancies in Ministry","qtype":"UNSTARRED ","ans_date":"29.01.2026","adate":"2026-01-29T00:00:00","shri":"Smt.      ","qno":15,"name":"Mamata Thakur                           ","min_name":"COMMUNICATIONS","qn_text":"(a) the number of sanctioned posts and vacancies, including reserved posts across categories in the Ministry;\r\n(b) the number of vacancies in the Ministry and Departments, for reserved posts since 2020, year-wise and category-wise; and\r\n(c) the number of contractual employees hired since 2020, year-wise and category-wise?","ans_text":null,"ses_no":270,"depc":14,"status":"Answered  ","P_flag":"Y","files":"https://sansad.in/getFile/annex/270/AU15_s5Tn2M.pdf?source=pqars","hindifiles":"https://sansad.in/getFile/qhindi/270/AU15_s5Tn2M.pdf?source=pqars","eng_file_name":"AU15_s5Tn2M.pdf","hindi_file_name":"AU15_s5Tn2M.pdf","eng_file_dsp":"/getFile/annex/270/AU15_s5Tn2M.pdf?source=pqars","hindi_file_dsp":"/getFile/qhindi/270/AU15_s5Tn2M.pdf?source=pqars","min_code":0,"supp":null}]},"special_mentions":{"source":"https://rsdoc.nic.in/memberGetdata/Get_SpecialMentionmemberwise?mpcode=2619","status":"available","total":1,"source_total":1,"records":[{"mp_code":2619,"mp_name":"Smt.                Mamata                                                      Thakur                                                      ","sr_no":19,"subject":"Urgent need to address delay in name change of West Bengal.","sess_no":266,"SM_Text":"<p><p class=MsoNormal align=center style=margin-bottom:0in;text-align:center;\r\nline-height:normal><b><u><span lang=EN-US style=font-size:12.0pt;font-family:\r\n\"Times New Roman\",serif><span style=text-decoration:none>&nbsp;</span></span></u></b></p>\r\n\r\n<p class=MsoNormal style=margin-top:0in;margin-right:0in;margin-bottom:0in;\r\nmargin-left:1.0in;text-align:justify;text-justify:inter-ideograph;text-indent:\r\n-1.0in;line-height:normal><span lang=EN-US style=font-size:12.0pt;font-family:\r\n\"Times New Roman\",serif>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style=margin-bottom:0in;text-align:justify;text-justify:\r\ninter-ideograph;line-height:normal><span lang=EN-US style=font-size:12.0pt;\r\nfont-family:\"Times New Roman\",serif>Smt. Mamata Thakur: In 2016, the State\r\nGovernment had sent a proposal to the Home Ministry to change West Bengal?s\r\nname to ?Bengal? in English, ?Bangla? in Bengali and ?Bangal? Hindi, but it was\r\nrejected by the Ministry advising <s>us</s> to use the name Bangla in all three\r\nlanguages. Therefore, on July 26, 2018 the Bengal Assembly unanimously passed a\r\nresolution to change the name of our State from West Bengal to Bangla. </span></p>\r\n\r\n<p class=MsoNormal style=margin-bottom:0in;text-align:justify;text-justify:\r\ninter-ideograph;line-height:normal><span lang=EN-US style=font-size:12.0pt;\r\nfont-family:\"Times New Roman\",serif>After Independence, there have been\r\nchanges in the name of States and cities, like Orissa to Odisha, Pondicherry to\r\nPuducherry. Madras to Chennai, Bombay to Mumbai, Bangalore to Bengaluru etc.\r\nThe demand to change West Bengal?s name to Bangla is based on the sentiments of\r\nthe people of the State, and our reverence towards our mother tongue.</span></p>\r\n\r\n<p class=MsoNormal style=margin-bottom:0in;text-align:justify;text-justify:\r\ninter-ideograph;line-height:normal><span lang=EN-US style=font-size:12.0pt;\r\nfont-family:\"Times New Roman\",serif>I demand that the Government should accept\r\nthe proposal to change West Bengal?s name to Bangla, immediately.</span></p>\r\n\r\n<p class=MsoNormal align=right style=margin-bottom:0in;text-align:right;\r\nline-height:normal><span lang=EN-US style=font-size:12.0pt;font-family:DVOT-Yogesh>(ENDS)</span></p>\r\n\r\n<p class=MsoNormal style=margin-bottom:0in;text-align:justify;text-justify:\r\ninter-ideograph;line-height:normal><b><span lang=EN-US style=font-size:12.0pt;\r\nfont-family:\"Times New Roman\",serif></p>","Admis_Sno":0,"Made":"y","made_Date":"04/12/2024","Ministry":"HOME AFFAIRS","dt_iss":null,"proposed_dt":null,"MIN_NO":"33","Permitted":"y","Date_Permission":"-         ","sno_made":19,"dt_final":null,"reply":"No Reply","made_date_compare":"2024-12-04T00:00:00"}]},"committees":{"source":"https://integration.rajyasabha.digital/committee-integration/api/v1/web/mp/Get_Committee_DetailMemberwise?mpcode=2619","status":"available","total":2,"source_total":2,"records":[{"memname":"Mamata Thakur","comname":"Committee on the Welfare of Scheduled Castes and Scheduled Tribes","comm_code":56,"comm_code_old":"56","frmdate":"2026-05-01 00:00:00","date":"01/05/2026","type":"Member","h