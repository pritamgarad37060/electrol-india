/my-gallery?mpCode=2580&page=1&size=500&searchText=&sortBy&debCode=&date="},{"member_id":2580,"title":"Special Mention","url":"https://sansad.in/getFile/AVDebates/AVRSDebatesClips/VideoGallery/Videos/video4801-07-29-2024.mp4?source=membersrsmedia","date":"2024-07-29","source_date":"29/07/2024","session":265,"category":"Special Mention","category_code":13,"size":"469 MB","source":"https://sansad.in/api_rs/mpDashboard/my-gallery?mpCode=2580&page=1&size=500&searchText=&sortBy&debCode=&date="},{"member_id":2580,"title":"Special Mention","url":"https://sansad.in/getFile/AVDebates/AVRSDebatesClips/VideoGallery/Videos/video4630-07-24-2024.mp4?source=membersrsmedia","date":"2024-07-24","source_date":"24/07/2024","session":265,"category":"Special Mention","category_code":13,"size":"40 MB","source":"https://sansad.in/api_rs/mpDashboard/my-gallery?mpCode=2580&page=1&size=500&searchText=&sortBy&debCode=&date="},{"member_id":2580,"title":"Matters raised with the permission of the Chair","url":"https://sansad.in/getFile/AVDebates/AVRSDebatesClips/VideoGallery/Videos/video4014-02-07-2024.mp4?source=membersrsmedia","date":"2024-02-07","source_date":"07/02/2024","session":263,"category":"Special Mention","category_code":13,"size":"40 MB","source":"https://sansad.in/api_rs/mpDashboard/my-gallery?mpCode=2580&page=1&size=500&searchText=&sortBy&debCode=&date="},{"member_id":2580,"title":"Matter raised with the permission of the Chair","url":"https://sansad.in/getFile/AVDebates/AVRSDebatesClips/VideoGallery/Videos/video2908-12-06-2023.mp4?source=membersrsmedia","date":"2023-12-06","source_date":"06/12/2023","session":262,"category":"Special Mention","category_code":13,"size":"50 MB","source":"https://sansad.in/api_rs/mpDashboard/my-gallery?mpCode=2580&page=1&size=500&searchText=&sortBy&debCode=&date="},{"member_id":2580,"title":"Short Duration Discussion on the Economic Situation in the Countary","url":"https://sansad.in/getFile/AVDebates/AVRSDebatesClips/VideoGallery/Videos/video2959-12