{
  "name": "electrol-india-com",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/server.mjs",
    "dev": "node --watch tools/server.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "check:account": "node tools/check-account.mjs",
    "check:connection": "node tools/check-account-connection.mjs",
    "check:browser": "node tools/check-html-bridge.mjs",
    "check:transport": "node tools/check-account-transport.mjs",
    "check:navigation": "node tools/check-navigation.mjs",
    "check:desktop-header": "node tools/check-desktop-header.mjs",
    "check:following": "node tools/check-following.mjs",
    "check:google": "node tools/check-google-signin.mjs",
    "check:home": "node tools/check-home-performance.mjs",
    "check:startup": "node tools/check-server-startup.mjs",
    "check:account:live": "node tools/check-account-live.mjs",
    "prepare:data": "node tools/sync-public-data.mjs pull",
    "check:directories": "node tools/check-connected-directories.mjs",
    "import:original": "node tools/connect-directories.mjs && node tools/import-original-data.mjs",
    "data:push": "node tools/sync-public-data.mjs push",
    "data:pull": "node tools/sync-public-data.mjs pull",
    "data:verify": "node tools/sync-public-data.mjs verify",
    "data:plan": "node tools/sync-public-data.mjs plan",
    "check:profiles": "node tools/check-connected-profiles.mjs",
    "check:profile-details": "node tools/check-profile-details.mjs",
    "check:rajya-sabha": "node tools/check-rajya-sabha.mjs",
    "check:rajya-sabha-enrichment": "node tools/check-rajya-sabha-enrichment.mjs",
    "enrich:rajya-sabha": "node tools/enrich-rajya-sabha.mjs",
    "check:parliament": "node tools/check-parliament-profiles.mjs",
    "import:parliament": "node tools/import-parliament-profiles.mjs",
    "import:rajya-sabha": "node tools/import-rajya-sabha.mjs",
    "check:data": "node tools/check-public-data.mjs",
    "check:media": "node tools/check-connected-media-maps.mjs",
    "check:hover": "node tools/check-profile-social-hover.mjs",
    "check:layout": "node tools/audit-website.mjs",
    "check:routes": "node tools/audit-website.mjs --routes",
    "check:seo": "node tools/check-seo.mjs --sitemap",
    "audit:data": "node tools/audit-data-coverage.mjs",
    "prepare:identities": "node tools/build-identities.mjs",
    "check:identities": "node tools/check-identities.mjs",
    "audit:people": "node tools/audit-person-records.mjs",
    "check:comparison-labels": "node tools/check-comparison-labels.mjs",
    "check:audit-fixes": "node tools/check-result-math.mjs && node tools/check-audit-fixes.mjs",
    "repair:data-quality": "node tools/repair-data-quality.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
