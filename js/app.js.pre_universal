function renderCmpStatesSeats(){
  const s1=getStateSummary(CMP_S1),s2=getStateSummary(CMP_S2);
  const filterFn=c=>{
    const p=c.w?P[c.w[3]]:'';
    if(CMP_ST_FILTER==='nda'&&!NDA.has(p))return false;
    if(CMP_ST_FILTER==='ind'&&!IND.has(p))return false;
    if(CMP_ST_FILTER==='close25k'&&c.m>=25000)return false;
    if(CMP_ST_FILTER==='landslide'&&c.m<100000)return false;
    return true;
  };
  const sortFn=(a,b)=>{
    if(CMP_ST_SORT==='margin-asc')return a.m-b.m;
    if(CMP_ST_SORT==='margin-desc')return b.m-a.m;
    if(CMP_ST_SORT==='turnout')return b.t-a.t;
    if(CMP_ST_SORT==='name')return a.n.localeCompare(b.n);
    return 0;
  };

  const list1=s1.cs.filter(filterFn).sort(sortFn);
  const list2=s2.cs.filter(filterFn).sort(sortFn);

  const miniTbl=(name,list)=>`
    <div class="cmp-state-box">
      <h3 style="margin:0 0 8px;font-size:14px;color:var(--p)">${esc(name)} (${list.length} seats)</h3>
      ${list.length?tbl(['Constituency','Winner','Party','Margin','Turnout'],
        list.map(c=>`<tr class="r">
          <td><a onclick="go('pc/${c.id}')"><b>${esc(c.n)}</b></a></td>
          <td>${esc(c.w[0])}</td>
          <td>${dot(c.w[3])}${sh(c.w[3],15)} ${esc(lab(c.w[3]))}</td>
          <td><b>${f(c.m)}</b></td>
          <td>${c.t.toFixed(1)}%</td>
        </tr>`)
      ):'<p class="note">No seats match this filter in this state.</p>'}
    </div>
  `;

  return `<div class="g g2">${miniTbl(s1.name,list1)}${miniTbl(s2.name,list2)}</div>`;
}

