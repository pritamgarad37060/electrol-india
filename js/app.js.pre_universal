function resetPCSFilters(){
  PCS_HOUSE='all';PCS_CHIP='';PCS_PAGE_SIZE=50;
  ['all','ls','mh','ap'].forEach(k=>{
    const b=$('pcstab-'+k);if(b)b.classList.toggle('on',k==='all');
  });
  document.querySelectorAll('.filter-chip[data-chip]').forEach(el=>el.classList.remove('active'));
  if($('fq'))$('fq').value='';
  if($('fs'))$('fs').value='';
  if($('fp'))$('fp').value='';
  if($('fc'))$('fc').value='';
  if($('fm'))$('fm').value='';
  if($('fsort'))$('fsort').value='default';
  fl();
