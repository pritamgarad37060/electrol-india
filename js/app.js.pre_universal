function fl(){
  const out=$('fr');if(!out)return;
  const q=($('fq')?$('fq').value:'').toLowerCase().trim();
  const s=$('fs')?$('fs').value:'';
  const p=$('fp')?$('fp').value:'';
  const ty=$('fc')?$('fc').value:'';
  const mg=$('fm')?$('fm').value:'';
  const sort=$('fsort')?$('fsort').value:'default';

  const all=getUnifiedPCs();
  let r=all.filter(c=>{
    if(PCS_HOUSE!=='all'&&c.houseCode!==PCS_HOUSE)return false;
    if(q){
      const matchN=c.name.toLowerCase().includes(q);
      const matchW=c.winner.toLowerCase().includes(q);
      const matchR=c.runner.toLowerCase().includes(q);
      const matchNo=String(c.no)===q;
      if(!matchN&&!matchW&&!matchR&&!matchNo)return false;
    }
    if(s&&c.state!==s)return false;
    if(p&&c.winnerParty!==p)return false;
    if(ty&&c.cat!==ty)return false;
    if(mg==='thin'&&c.margin>=5000)return false;
    if(mg==='close'&&(c.margin<5000||c.margin>=25000))return false;
    if(mg==='med'&&(c.margin<25000||c.margin>=100000))return false;
    if(mg==='landslide'&&c.margin<100000)return false;
    if(PCS_CHIP==='close10k'&&c.margin>=10000)return false;
    if(PCS_CHIP==='close25k'&&c.margin>=25000)return false;
    if(PCS_CHIP==='landslide'&&c.margin<100000)return false;
    if(PCS_CHIP==='turnout80'&&c.turnout<80)return false;
    if(PCS_CHIP==='women'&&!c.isWomen)return false;
    return true;
  });

  if(sort==='margin-asc')r.sort((a,b)=>a.margin-b.margin);
  else if(sort==='margin-desc')r.sort((a,b)=>b.margin-a.margin);
  else if(sort==='turnout-desc')r.sort((a,b)=>b.turnout-a.turnout);
  else if(sort==='turnout-asc')r.sort((a,b)=>a.turnout-b.turnout);
  else if(sort==='electors-desc')r.sort((a,b)=>b.el-a.el);
  else if(sort==='name-asc')r.sort((a,b)=>a.name.localeCompare(b.name));

  const total=all.length,count=r.length,pageItems=r.slice(0,PCS_PAGE_SIZE);
  const houseBadge=h=>h==='ls'?'<span class="badge-house badge-ls">🏛️ Lok Sabha</span>':(h==='mh'?'<span class="badge-house badge-mh">🏢 MH Assembly</span>':'<span class="badge-house badge-ap">🏛️ AP Assembly</span>');

  out.innerHTML=`
    <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 6px;flex-wrap:wrap;gap:8px">
      <span class="note">Showing <b>${pageItems.length}</b> of <b>${f(count)}</b> matching constituencies (${f(total)} total across India)</span>
      <span class="note">Tap any column header to sort</span>
    </div>
  `+(count?tbl(
    ['House','Constituency','State / UT','Category','Winner','Party','Runner-up','Runner Party','Margin','Turnout','Action'],
    pageItems.map(c=>`
      <tr class="r" style="cursor:pointer" onclick="go('${c.link}')">
        <td>${houseBadge(c.houseCode)}</td>
        <td><b><a onclick="event.stopPropagation();go('${c.link}')">${esc(c.name)}</a></b></td>
        <td>${esc(c.state)}</td>
        <td>${c.cat}</td>
        <td><b>${esc(c.winner)}</b>${c.isWomen?' 👩':''}</td>
        <td>${dot2(c.winnerParty)}${shc(c.winnerParty,16)} ${esc(lc(c.winnerParty))}</td>
        <td>${esc(c.runner)}</td>
        <td>${c.runnerParty?dot2(c.runnerParty)+' '+shc(c.runnerParty,16)+' '+esc(lc(c.runnerParty)):'–'}</td>
        <td><b>${f(c.margin)}</b></td>
        <td>${c.turnout?c.turnout.toFixed(1)+'%':'–'}</td>
        <td><button class="btn" style="padding:2px 8px;font-size:11px" onclick="event.stopPropagation();go('${c.link}')">View Seat →</button></td>
      </tr>
    `)
  ):`<div style="text-align:center;padding:32px 14px"><p style="font-size:15px;color:var(--m)">No constituencies match current filters.</p><button class="btn on" onclick="resetPCSFilters()">Reset Filters</button></div>`)+
  (count>PCS_PAGE_SIZE?`<p style="text-align:center;margin-top:14px"><button class="btn on" onclick="PCS_PAGE_SIZE+=50;fl()">Load more (+50) — ${count-PCS_PAGE_SIZE} remaining</button></p>`:'');

  tr(out);
}

