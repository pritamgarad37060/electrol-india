      const c=(data.constituencies||[]).find(x=>x.ac_no===no||x.pc_no===no);
      if(!c){el.innerHTML='<p class="note">Lok Sabha constituency not found.</p>';return}
      const cands=(data.candidates_by_ac&&(data.candidates_by_ac[no]||data.candidates_by_ac[String(no)]))||c.candidates||[];
      
      const non_nota=cands.filter(x=>!x.is_nota).sort((a,b)=>b.total_votes-a.total_votes);
      const w=non_nota[0], r=non_nota[1];
      const tv=c.votes_polled||cands.reduce((sum,cd)=>sum+(cd.total_votes||0),0);
      const mx=w?w.total_votes:1;
      
      const box=(x,k,cls)=>{if(!x)return'';return`<div class="pb ${cls}"><div class="av" style="font-size:22px">${shc(x.party,44)||av(x.name)}</div><div><small>${k}</small><br><b style="font-size:16px">${esc(x.name)}</b><br>${dot2(x.party)} ${esc(lc(x.party))}<br><b>${f(x.total_votes)} (${pc(x.total_votes,tv)}%)</b></div></div>`};

      el.innerHTML=`
        ${bc([['Home',''],[`Lok Sabha ${yr}`,`ls/${yr}`],[c.name]])}
        <h1 style="color:var(--g)">${esc(c.name)}</h1>
        <span class="bc">Lok Sabha Constituency · PC ${c.ac_no} · Category: <b>${c.category}</b> · Maharashtra · ${yr}</span>
        
        <div class="g g2" style="margin-top:12px">${box(w,'Winner','win')}${box(r,'Runner-up','run')}</div>
        
        ${stats([[c.margin?f(c.margin):'–','Winning Margin'],[f(c.electors),'Electors'],[c.votes_polled?f(c.votes_polled):'–','Votes Polled'],[c.turnout_pct?c.turnout_pct.toFixed(1)+'%':'–','Turnout'],[cands.length,'Candidates'],[f(c.nota_votes||0)+' ('+pc(c.nota_votes,tv)+'%)','NOTA']])}
        
        <div class="card">
          <h2>Vote share</h2>
          ${cands.slice(0,6).map(x=>{
            return `<div style="margin:6px 0">${dot2(x.party)}${esc(x.name)} (${esc(lc(x.party))}) · ${pc(x.total_votes,tv)}%<br><span class="bar" style="width:${x.total_votes/mx*100}%;background:${colC(x.party)}"></span></div>`;
          }).join('')}
        </div>

        <div class="card" style="margin-top:16px">
          <h2>All Candidates &amp; Votes Polled</h2>
          ${tbl(['#','Candidate Name','Party','Gender','EVM Votes','Postal','Total Votes','Vote %'],
            cands.map((cd,idx)=>`<tr class="r"${idx===0&&!cd.is_nota?' style="background:rgba(10,125,59,0.1);font-weight:600"':''}>
              <td>${idx+1}</td>
              <td><b>${esc(cd.name)}</b>${idx===0&&!cd.is_nota?' 🏆':''}</td>
              <td>${dot2(cd.party)}${shc(cd.party,16)} ${esc(lc(cd.party))}</td>
              <td>${cd.gender||'–'}</td>
              <td>${f(cd.evm_votes||0)}</td>
              <td>${f(cd.postal_votes||0)}</td>
              <td><b>${f(cd.total_votes||0)}</b></td>
              <td>${cd.vote_pct?cd.vote_pct.toFixed(2)+'%':pc(cd.total_votes,tv)+'%'} <span class="bar" style="width:${cd.total_votes/tv*80}px;background:${colC(cd.party)}"></span></td>
            </tr>`)
          )}
        </div>
        <p><button class="btn" onclick="go('ls/${yr}')">← Back to All 48 Constituencies</button></p>
      `;
      tr(el);
    });
  },10);
  return'<p>Loading constituency data…</p>';
