function setPCSChip(chip){
  PCS_CHIP=PCS_CHIP===chip?'':chip;
  document.querySelectorAll('.filter-chip[data-chip]').forEach(el=>{
    el.classList.toggle('active',el.dataset.chip===PCS_CHIP);
  });
