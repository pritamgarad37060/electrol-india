'aphcmp':(y1,y2)=>{
  const divId='aphcmp-c';
  setTimeout(()=>{
    const el=document.getElementById(divId);
    if(!el)return;
    el.innerHTML='<p>Loading data for '+y1+' and '+y2+'…</p>';
    Promise.all([new Promise(ok=>loadAPYear(+y1,ok)),new Promise(ok=>loadAPYear(+y2,ok))]).then(([d1,d2])=>{
      if(!d1||!d2){el.innerHTML='<p class="note">Data not available for one or both years.</p>';return}
      const topP=arr=>arr.ps.filter(p=>p.seats).slice(0,10);
      const p1=topP(d1),p2=topP(d2);
      const allParties=[...new Set([...p1.map(x=>x.c),...p2.map(x=>x.c)])];
      const swingRows=allParties.map(c=>{
        const a=(d1.ps.find(p=>p.c===c)||{seats:0,votes:0});const b=(d2.ps.find(p=>p.c===c)||{seats:0,votes:0});
        const delta=b.seats-a.seats;
        const vs1=d1.tot?pc(a.votes,d1.tot):'–', vs2=d2.tot?pc(b.votes,d2.tot):'–';
        return`<tr class="r"><td>${dot2(c)} ${esc(lc(c))}</td><td>${a.seats}</td><td>${b.seats}</td><td class="${delta>0?'swing-pos':delta<0?'swing-neg':''}">${delta>0?'+':''}${delta}</td><td>${vs1}%</td><td>${vs2}%</td></tr>`;
      }).join('');

      // Flipped seats check (if matching AC count or names)
      let flips=[];
      if(d1.ac&&d2.ac){
        const map1={};d1.ac.forEach(c=>{map1[c.no]=c.wp||(d1.MP[c.w?c.w[3]:0])});
        d2.ac.forEach(c=>{
          const p2=c.wp||(d2.MP[c.w?c.w[3]:0]);
          const p1=map1[c.no];
          if(p1&&p2&&p1!==p2){flips.push({no:c.no,n:c.n,from:p1,to:p2,winner:c.wn||(c.w?c.w[0]:'')})};
        });
      }

      el.innerHTML=`
        <div class="card" style="margin-bottom:14px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <b>Switch comparison:</b>
            <select id="sw-y1" onchange="go('aphcmp/'+this.value+'/'+$('sw-y2').value)">${AP_YEARS.slice().reverse().map(y=>`<option value="${y}" ${+y===+y1?'selected':''}>${y}</option>`).join('')}</select>
            vs
            <select id="sw-y2" onchange="go('aphcmp/'+$('sw-y1').value+'/'+this.value)">${AP_YEARS.slice().reverse().map(y=>`<option value="${y}" ${+y===+y2?'selected':''}>${y}</option>`).join('')}</select>
            <div style="margin-left:auto;display:flex;gap:6px">
              <button class="btn" onclick="go('aph/${y1}')">${y1} Full Results →</button>
              <button class="btn" onclick="go('aph/${y2}')">${y2} Full Results →</button>
            </div>
          </div>
        </div>
        <div class="g g2">
          <div class="cmp-col left"><div class="cmp-header">📅 ${y1} Assembly</div>
            ${stats([[d1.ac.length,'Total Seats'],[pc(d1.tot,d1.el)+'%','Turnout'],[(d1.el/1e7).toFixed(2)+' Cr','Electors'],[(d1.tot/1e7).toFixed(2)+' Cr','Votes Polled']])}
          </div>
          <div class="cmp-col right"><div class="cmp-header">📅 ${y2} Assembly</div>
            ${stats([[d2.ac.length,'Total Seats'],[pc(d2.tot,d2.el)+'%','Turnout'],[(d2.el/1e7).toFixed(2)+' Cr','Electors'],[(d2.tot/1e7).toFixed(2)+' Cr','Votes Polled']])}
          </div>
        </div>
        <div class="card" style="margin-top:14px">
          <h2>Party Swing: ${y1} → ${y2}</h2>
          ${tbl(['Party',y1+' Seats',y2+' Seats','Seat Swing',y1+' Vote %',y2+' Vote %'],swingRows.split('</tr>').filter(Boolean).map(r=>r+'</tr>'))}
        </div>
        ${flips.length?`<div class="card" style="margin-top:14px">
          <h2>🔄 Flipped Constituencies (${flips.length} seats changed hands)</h2>
          <p class="note">Seats where winning party changed between ${y1} and ${y2}:</p>
          <div style="max-height:300px;overflow-y:auto">${tbl(['AC No.','Constituency',y1+' Winner Party',y2+' Winner Party',y2+' Winner Candidate'],flips.slice(0,50).map(f=>`<tr class="r"><td>${f.no}</td><td><b>${esc(f.n)}</b></td><td>${dot2(f.from)} ${esc(lc(f.from))}</td><td><b>${dot2(f.to)} ${esc(lc(f.to))}</b></td><td>${esc(f.winner)}</td></tr>`))}</div>
        </div>`:''}
      `;
    });
  },0);
  return`${bc([['Home',''],['Previous Elections','aph'],['Compare']])}<h1>⚖️ Compare Andhra Pradesh: ${y1} vs ${y2}</h1><div id="${divId}"><p>Loading…</p></div>`;
},
'aps':a=>{initAP();const [q0,p0]=decodeURIComponent(a||'').split('|'),ps=AP.ps.filter(p=>p.seats);return`${bc([['Home',''],['Andhra Pradesh','ap'],['Constituencies']])}<h1>Andhra Pradesh – All 175 Constituencies</h1><div class="card"><div class="f"><input id="apq" aria-label="Search" placeholder="Search constituency / winner" value="${esc(q0||'')}" oninput="apfl()"><select id="appp" aria-label="Party" onchange="apfl()"><option value="">All winning parties</option>${ps.map(p=>`<option value="${p.c}" ${p0===p.c?'selected':''}>${esc(lc(p.c))}</option>`)}</select></div><div id="apr"></div></div>`},
'apac':no=>{
