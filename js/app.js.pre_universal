'q':q=>{
  q=decodeURIComponent(q||'').toLowerCase().trim();
  initMH();initAP();
  
  // 1. Lok Sabha Constituencies
  const cs=q?PC.filter(c=>c.n.toLowerCase().includes(q)||S[c.si].toLowerCase().includes(q)).slice(0,30):[];
  
  // 2. Lok Sabha Candidates
  const cd=[];
  if(q.length>1){
    for(const c of PC){
      for(const x of c.cs){
        if(x[3]!=NI&&x[0].toLowerCase().includes(q)){
          cd.push([x,c]);
          if(cd.length>=50)break;
        }
      }
      if(cd.length>=50)break;
    }
  }

  // 3. Maharashtra Assembly Constituencies
  const mhc=MH&&MH.ac?MH.ac.filter(c=>c.n.toLowerCase().includes(q)||c.dist.toLowerCase().includes(q)).slice(0,30):[];

  // 4. Maharashtra Assembly Candidates (ALL candidates)
  const mhcd=[];
  if(MH&&MH.ac&&q.length>1){
    for(const c of MH.ac){
      for(const x of c.cs){
        const p=MH.MP[x[3]];
        if(p!='NOTA'&&x[0].toLowerCase().includes(q)){
          mhcd.push({x,c,p,isW:x===c.w,isR:x===c.r});
          if(mhcd.length>=50)break;
        }
      }
      if(mhcd.length>=50)break;
    }
  }

  // 5. Andhra Pradesh Assembly Constituencies
  const apc=AP&&AP.ac?AP.ac.filter(c=>c.n.toLowerCase().includes(q)).slice(0,30):[];

  // 6. Andhra Pradesh Assembly Candidates (ALL candidates)
  const apcd=[];
  if(AP&&AP.ac&&q.length>1){
    for(const c of AP.ac){
      for(const x of c.cs){
        const p=AP.MP[x[3]];
        if(p!='NOTA'&&x[0].toLowerCase().includes(q)){
          apcd.push({x,c,p,isW:x===c.w,isR:x===c.r});
          if(apcd.length>=50)break;
        }
      }
      if(apcd.length>=50)break;
    }
