      mhcd.map(({x,c,p,isW,isR})=>`<tr class="r"><td><b>${esc(x[0])}</b></td><td>${dot2(p)}${shc(p,16)} ${esc(lc(p))}</td><td><a onclick="go('ac/${c.no}')">${esc(c.n)}</a></td><td>${esc(c.dist)}</td><td>${f(x[6])}</td><td>${pc(x[6],c.po)}%</td><td>${isW?'<span class="badge" style="background:var(--win);color:var(--g)">🏆 Won</span>':(isR?'<span class="badge" style="background:rgba(255,107,0,0.15);color:var(--saffron)">🥈 Runner-up</span>':'Contested')}</td></tr>`)
    ):'<p class="note">Type at least 2 characters to search all 4,100+ Maharashtra candidates.</p>'}
