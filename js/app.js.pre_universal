let CMP_S1=S.indexOf('Uttar Pradesh')>=0?S.indexOf('Uttar Pradesh'):0;
let CMP_S2=S.indexOf('Maharashtra')>=0?S.indexOf('Maharashtra'):1;
let CMP_ST_FILTER='all',CMP_ST_SORT='default';

function getStateSummary(si){
  si=+si;if(si<0||si>=S.length)si=0;
  const a=SA[si];
  const nda=a.cs.filter(c=>NDA.has(P[c.w[3]])).length+(si===SURAT.si?1:0);
  const ind=a.cs.filter(c=>IND.has(P[c.w[3]])).length;
  const oth=a.seats-nda-ind;
  const sortedM=a.cs.slice().sort((x,y)=>x.m-y.m);
  const minM=sortedM[0]||null;
  const maxM=sortedM[sortedM.length-1]||null;
  const avgM=a.cs.length?Math.round(a.cs.reduce((s,c)=>s+c.m,0)/a.cs.length):0;
  const turnout=a.el?(a.po/a.el*100):0;
  const par=Object.entries(a.m).sort((x,y)=>y[1]-x[1]);
  return{si,name:S[si],a,seats:a.seats,nda,ind,oth,minM,maxM,avgM,turnout,par,cs:a.cs,el:a.el,po:a.po};
}

