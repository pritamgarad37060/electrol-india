let PCS_HOUSE='all',PCS_CHIP='',PCS_PAGE_SIZE=50;

function getUnifiedPCs(){
  initMH();initAP();
  const list=[];
  PC.forEach(c=>{
    const isWom=c.w&&c.w[1]==='F';
    const wp=lab(c.w[3]);
    const rp=c.r?lab(c.r[3]):'';
    list.push({
      house:'Lok Sabha',
      houseCode:'ls',
      state:S[c.si],
      stateIdx:c.si,
      no:c.id+1,
      id:c.id,
      name:c.n,
      cat:c.cat,
      el:c.el,
      po:c.po,
      turnout:c.t,
      margin:c.m,
      nota:c.nota,
      winner:c.w[0],
      winnerParty:wp,
      isWomen:isWom,
      runner:c.r?c.r[0]:'–',
      runnerParty:rp,
      link:'pc/'+c.id
    });
  });
  if(MH&&MH.ac){
    MH.ac.forEach(c=>{
      const wp=MH.MP[c.w[3]]||'';
      const rp=c.r?(MH.MP[c.r[3]]||''):'';
      const isWom=c.w&&c.cs.find(x=>x===c.w&&x[1]==='F');
      list.push({
        house:'Maharashtra Assembly',
        houseCode:'mh',
        state:'Maharashtra',
        stateIdx:S.indexOf('Maharashtra'),
        no:c.no,
        id:c.no,
        name:c.n,
        cat:c.cat,
        el:c.el,
        po:c.po,
        turnout:c.t,
        margin:c.m,
        nota:c.nota,
        winner:c.w?c.w[0]:'–',
        winnerParty:wp,
        isWomen:!!isWom,
        runner:c.r?c.r[0]:'–',
        runnerParty:rp,
        link:'ac/'+c.no
      });
    });
  }
  if(AP&&AP.ac){
    AP.ac.forEach(c=>{
      const wp=AP.MP[c.w?c.w[3]:0]||'';
      const rp=c.r?(AP.MP[c.r[3]]||''):'';
      const isWom=c.w&&c.cs.find(x=>x===c.w&&x[1]==='F');
      list.push({
        house:'Andhra Pradesh Assembly',
        houseCode:'ap',
        state:'Andhra Pradesh',
        stateIdx:S.indexOf('Andhra Pradesh'),
        no:c.no,
        id:c.no,
        name:c.n,
        cat:c.cat,
        el:c.el,
        po:c.po,
        turnout:c.t,
        margin:c.m,
        nota:c.nota,
        winner:c.w?c.w[0]:'–',
        winnerParty:wp,
        isWomen:!!isWom,
        runner:c.r?c.r[0]:'–',
        runnerParty:rp,
        link:'apac/'+c.no
      });
    });
  }
  return list;
}

function setPCSHouse(h){
  PCS_HOUSE=h;
  ['all','ls','mh','ap'].forEach(k=>{
    const b=$('pcstab-'+k);if(b)b.classList.toggle('on',k===h);
  });
